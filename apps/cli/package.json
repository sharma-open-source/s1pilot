{
  "name": "s1pilot",
  "version": "0.4.0",
  "description": "AI-native web app testing: describe a test in plain language, explore it once with a System 1 decision model, replay it deterministically, heal it with AI.",
  "keywords": [
    "testing",
    "e2e",
    "playwright",
    "ai",
    "test-automation",
    "test-management",
    "llm",
    "qa",
    "self-healing"
  ],
  "homepage": "https://sharma-open-source.github.io/s1pilot/",
  "bugs": {
    "url": "https://github.com/sharma-open-source/s1pilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharma-open-source/s1pilot.git",
    "directory": "apps/cli"
  },
  "license": "Apache-2.0",
  "author": "Sharma Sathananthan",
  "type": "module",
  "bin": {
    "s1pilot": "./dist/index.js"
  },
  "files": [
    "dist",
    "migrations",
    "profiles",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@trpc/server": "^11",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.1.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5",
    "libsodium-wrappers": "^0.8.4",
    "nanoid": "^5.0.9",
    "nodemailer": "^10.1.1",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^9.5.0",
    "playwright": "^1.63.0",
    "ts-morph": "^28.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@s1pilot/db": "workspace:*",
    "@s1pilot/domain": "workspace:*",
    "@s1pilot/engine": "workspace:^",
    "@s1pilot/fixture-sites": "workspace:^",
    "@s1pilot/providers": "workspace:*",
    "@s1pilot/reporters": "workspace:*",
    "@s1pilot/runner": "workspace:*",
    "@s1pilot/server": "workspace:^",
    "@s1pilot/sync": "workspace:^",
    "@s1pilot/web": "workspace:^",
    "@types/pg": "^8.23.1",
    "actionlint": "^2.0.6"
  }
}
