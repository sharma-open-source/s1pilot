{
  "name": "@s1pilot/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/main.ts src/router.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "@s1pilot/db": "workspace:^",
    "@s1pilot/domain": "workspace:^",
    "@s1pilot/engine": "workspace:^",
    "@s1pilot/providers": "workspace:^",
    "@s1pilot/runner": "workspace:^",
    "@s1pilot/sync": "workspace:^",
    "@trpc/server": "^11",
    "fastify": "^5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@s1pilot/fixture-sites": "workspace:*",
    "@trpc/client": "^11",
    "@types/ws": "^8.18.2",
    "ws": "^8.18.0",
    "tsx": "^4.23.15"
  }
}
