{
  "name": "@s1pilot/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "drizzle",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/seed.ts --format esm --dts --clean",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed:demo": "pnpm build && node dist/seed.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "@s1pilot/domain": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "libsodium-wrappers": "^0.8.4",
    "zod": "^3.23.8"
  }
}
